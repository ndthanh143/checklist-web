{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["./**/*.ts", "../server/**/*.ts", "../src/content/**/*.ts", "../src/job/types.ts"],
  "exclude": ["./**/*.test.ts", "../server/**/*.test.ts", "../server/neonStore.ts", "../server/vercelEnv.ts", "../server/vercelStore.ts"]
}
